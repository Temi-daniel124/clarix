# Clarix — environment variable template.
#
# Copy to .env.local (gitignored) and fill in from the Supabase dashboard
# (Project Settings -> API) for the `Clarix` project, ref sxugaizwmqigtioqgefx.
# Never commit real values, in any form — see SECURITY.md.

NEXT_PUBLIC_SUPABASE_URL=https://sxugaizwmqigtioqgefx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. No Clarix code path uses this yet; introducing one means adding an entry to
# SECURITY.md first, naming the file and why RLS cannot be used there instead.
SUPABASE_SERVICE_ROLE_KEY=

# Sends the Help screen's support message (blueprint 6.3). Without it that form fails honestly
# and the screen falls back to the mailto link, which always works.
RESEND_API_KEY=

# Where Help's contact form sends, and the verified sender it sends from (DECISIONS.md D026).
# Both have working defaults in src/lib/support.ts; set them to override.
CLARIX_SUPPORT_EMAIL=
CLARIX_SUPPORT_FROM=

# Not needed until the payslip OCR fallback is built (P1).
AI_PAYSLIP_API_KEY=
