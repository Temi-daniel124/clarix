# Clarix — environment variable template.
#
# Copy to .env.local (gitignored) and fill in from the Supabase dashboard
# (Project Settings -> API) for the `Clarix` project, ref sxugaizwmqigtioqgefx.
# Never commit real values, in any form — see SECURITY.md.

NEXT_PUBLIC_SUPABASE_URL=https://sxugaizwmqigtioqgefx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. No Clarix code path uses this yet; introducing one means adding an entry to
